<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>

<template id="__bundler_thumbnail">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200"><rect width="200" height="200" fill="#1B3B2F"/><circle cx="100" cy="100" r="55" fill="none" stroke="#C6A144" stroke-width="6"/><text x="100" y="112" font-size="48" text-anchor="middle" fill="#F7EFDC" font-family="serif">V&amp;A</text></svg>
</template>
<helmet>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Poppins:wght@300;400;500;600&family=Parisienne&display=swap" rel="stylesheet">
  <script src="./image-slot.js"></script>
  <style>
    html, body { margin: 0; background: #FBF6E9; height: 100%; overflow: hidden; }
    * { box-sizing: border-box; }
    a { color: #C6A144; text-decoration: none; }
    a:hover { color: #8f7226; text-decoration: underline; }
    @keyframes shimmer { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
    @keyframes drift { 0% { transform: translateY(0) rotate(var(--r, 0deg)); } 50% { transform: translateY(-10px) rotate(var(--r, 0deg)); } 100% { transform: translateY(0) rotate(var(--r, 0deg)); } }
    .gold-shimmer { animation: shimmer 3.5s ease-in-out infinite; }
    .drift-feather { animation: drift 6s ease-in-out infinite; }
    @keyframes swing { 0%, 100% { transform: rotate(-3.5deg); } 50% { transform: rotate(3.5deg); } }
    .garland-swing { transform-origin: top center; animation: swing 4.5s ease-in-out infinite; }
  </style>
</helmet>

<div style="font-family: 'Poppins', sans-serif; background: #12281E; color: #26301F; height: 100vh; width: 100%; overflow: hidden; position: relative;">

  <audio ref="{{ audioRef }}" src="assets/music.mp3" loop preload="auto"></audio>
  <div onClick="{{ toggleMusic }}" style="position: absolute; top: 14px; right: 14px; z-index: 50; width: 38px; height: 38px; border-radius: 50%; background: rgba(13,32,25,0.75); border: 1px solid #C6A144; display: flex; align-items: center; justify-content: center; cursor: pointer;">
    <sc-if value="{{ musicOn }}" hint-placeholder-val="{{ false }}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M3 10v4h4l5 5V5L7 10H3z" fill="#E4C77A"/><path d="M16 8.5a4.5 4.5 0 0 1 0 7" stroke="#E4C77A" stroke-width="1.6" stroke-linecap="round"/><path d="M18.5 6a8 8 0 0 1 0 12" stroke="#E4C77A" stroke-width="1.6" stroke-linecap="round"/></svg>
    </sc-if>
    <sc-if value="{{ musicOff }}" hint-placeholder-val="{{ true }}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M3 10v4h4l5 5V5L7 10H3z" fill="#E4C77A"/><path d="M16 9l5 6M21 9l-5 6" stroke="#E4C77A" stroke-width="1.6" stroke-linecap="round"/></svg>
    </sc-if>
  </div>

  <!-- SLIDE 0: HERO -->
  <div style="position: absolute; inset: 0; overflow: hidden; transition: transform 0.65s cubic-bezier(0.65,0,0.35,1), opacity 0.45s ease; transform: {{ s0.transform }}; opacity: {{ s0.opacity }}; z-index: {{ s0.z }}; pointer-events: {{ s0.pe }};">
    <div style="position: relative; width: 100%; height: 100%; background: #12281E; overflow: hidden;" onClick="{{ toggleDoor }}">
      <img src="assets/hero-frame-blank.jpg" alt="Vandana and Akhil wedding invitation" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;" />

      <div style="position: absolute; left: 18%; right: 18%; top: 6%; bottom: 17%; z-index: 5; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: clamp(8px, 1.6vw, 16px); text-align: center; pointer-events: none;">
        <div style="font-family: 'Cormorant Garamond', serif; font-size: clamp(11px, 1.5vw, 15px); letter-spacing: 0.18em; text-transform: uppercase; color: #3B4A32; opacity: {{ doorOpenOpacity }}; transform: {{ heroLineTransform }}; transition: opacity 0.6s ease 0.3s, transform 0.6s ease 0.3s;">Together with their families</div>
        <div style="font-family: 'Parisienne', cursive; font-size: clamp(34px, 5.5vw, 58px); color: #1B3B2F; opacity: {{ doorOpenOpacity }}; transform: {{ heroLineTransform }}; transition: opacity 0.6s ease 0.9s, transform 0.6s ease 0.9s;">Vandana &amp; Akhil</div>
        <div style="font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: clamp(14px, 1.9vw, 19px); line-height: 1.5; color: #3B4A32; opacity: {{ doorOpenOpacity }}; transform: {{ heroLineTransform }}; transition: opacity 0.6s ease 1.5s, transform 0.6s ease 1.5s;">request the honor of your presence to<br />celebrate their wedding</div>
        <div style="font-family: 'Cormorant Garamond', serif; font-weight: 700; font-size: clamp(13px, 1.8vw, 17px); letter-spacing: 0.06em; color: #A9822F; opacity: {{ doorOpenOpacity }}; transform: {{ heroLineTransform }}; transition: opacity 0.6s ease 2.1s, transform 0.6s ease 2.1s;">October 28 &ndash; 29, 2026 &middot; Colorado</div>
        <div style="font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: clamp(12px, 1.6vw, 15px); color: #3B4A32; opacity: {{ doorOpenOpacity }}; transform: {{ heroLineTransform }}; transition: opacity 0.6s ease 2.7s, transform 0.6s ease 2.7s;">Come celebrate love, family &amp; forever</div>
      </div>

      <div style="position: absolute; inset: 0; z-index: 6; perspective: 2400px;">
        <div style="position: absolute; top: -4px; left: 50%; transform: translateX(-50%); z-index: 9; width: 10px; height: 22px; background: linear-gradient(180deg,#e8c98a,#8a6432); border-radius: 50% 50% 0 0; box-shadow: 0 0 0 1px #4a3216;"></div>

        <!-- LEFT DOOR -->
        <div style="position: absolute; top: 0; left: 0; width: 50%; height: 100%; transform-style: preserve-3d; transform-origin: left center; transition: transform 1.2s cubic-bezier(0.7,0,0.3,1); transform: {{ doorLeftTransform }}; pointer-events: {{ doorPointerEvents }}; background-color: #6b4720; background-image: linear-gradient(135deg, #9c7a42 0%, #7a5726 55%, #4a3216 100%), repeating-linear-gradient(45deg, rgba(255,222,160,0.09) 0px, rgba(255,222,160,0.09) 1px, transparent 1px, transparent 9px), repeating-linear-gradient(-45deg, rgba(30,16,4,0.16) 0px, rgba(30,16,4,0.16) 1px, transparent 1px, transparent 9px); border-top-right-radius: 10% 55%; box-shadow: inset 0 0 0 7px #4a3216, inset 0 0 0 10px #c9a35d, inset 0 0 0 14px #4a3216, 6px 0 30px rgba(0,0,0,0.4);">
          <div style="position: absolute; top: -22px; left: 10%; width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg,#a9814a,#6b4720); border: 2px solid #4a3216;"></div>
          <div style="position: absolute; top: -30px; left: 32%; width: 46px; height: 46px; border-radius: 50%; background: linear-gradient(135deg,#a9814a,#6b4720); border: 2px solid #4a3216;"></div>
          <div style="position: absolute; top: -40px; left: 56%; width: 58px; height: 58px; border-radius: 50%; background: linear-gradient(135deg,#a9814a,#6b4720); border: 2px solid #4a3216;"></div>
          <div style="position: absolute; top: -52px; left: 78%; width: 74px; height: 74px; border-radius: 50%; background: linear-gradient(135deg,#a9814a,#6b4720); border: 2px solid #4a3216;"></div>
          <div style="position: absolute; inset: 16px; border: 2px solid #c9a35d; border-top-right-radius: 30% 70%;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 20%; border-top: 2px solid #4a3216;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 20%; border-top: 1px solid #c9a35d; margin-top: 2px;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 44%; border-top: 2px solid #4a3216;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 44%; border-top: 1px solid #c9a35d; margin-top: 2px;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 68%; border-top: 2px solid #4a3216;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 68%; border-top: 1px solid #c9a35d; margin-top: 2px;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 88%; border-top: 2px solid #4a3216;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 88%; border-top: 1px solid #c9a35d; margin-top: 2px;"></div>
          <div style="position: absolute; right: 0; top: 15%; bottom: 0; width: 12px; background: linear-gradient(90deg,transparent,#4a3216); box-shadow: -1px 0 0 rgba(0,0,0,0.3);"></div>
          <div style="position: absolute; top: 56%; left: 50%; transform: translate(-50%,-50%); width: 16px; height: 11px; border-radius: 3px 3px 2px 2px; background: linear-gradient(180deg,#e8c98a,#8a6432); border: 1px solid #4a3216;"></div>
          <div style="position: absolute; top: 63%; left: 50%; transform: translate(-50%,0); width: 32px; height: 32px; border-radius: 50%; background: transparent; border: 6px solid #c9a35d; box-shadow: inset 0 2px 3px rgba(0,0,0,0.35), 0 1px 2px rgba(0,0,0,0.4);"></div>
        </div>

        <!-- RIGHT DOOR -->
        <div style="position: absolute; top: 0; right: 0; width: 50%; height: 100%; transform-style: preserve-3d; transform-origin: right center; transition: transform 1.2s cubic-bezier(0.7,0,0.3,1); transform: {{ doorRightTransform }}; pointer-events: {{ doorPointerEvents }}; background-color: #6b4720; background-image: linear-gradient(225deg, #9c7a42 0%, #7a5726 55%, #4a3216 100%), repeating-linear-gradient(45deg, rgba(255,222,160,0.09) 0px, rgba(255,222,160,0.09) 1px, transparent 1px, transparent 9px), repeating-linear-gradient(-45deg, rgba(30,16,4,0.16) 0px, rgba(30,16,4,0.16) 1px, transparent 1px, transparent 9px); border-top-left-radius: 10% 55%; box-shadow: inset 0 0 0 7px #4a3216, inset 0 0 0 10px #c9a35d, inset 0 0 0 14px #4a3216, -6px 0 30px rgba(0,0,0,0.4);">
          <div style="position: absolute; top: -22px; right: 10%; width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg,#a9814a,#6b4720); border: 2px solid #4a3216;"></div>
          <div style="position: absolute; top: -30px; right: 32%; width: 46px; height: 46px; border-radius: 50%; background: linear-gradient(135deg,#a9814a,#6b4720); border: 2px solid #4a3216;"></div>
          <div style="position: absolute; top: -40px; right: 56%; width: 58px; height: 58px; border-radius: 50%; background: linear-gradient(135deg,#a9814a,#6b4720); border: 2px solid #4a3216;"></div>
          <div style="position: absolute; top: -52px; right: 78%; width: 74px; height: 74px; border-radius: 50%; background: linear-gradient(135deg,#a9814a,#6b4720); border: 2px solid #4a3216;"></div>
          <div style="position: absolute; inset: 16px; border: 2px solid #c9a35d; border-top-left-radius: 30% 70%;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 20%; border-top: 2px solid #4a3216;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 20%; border-top: 1px solid #c9a35d; margin-top: 2px;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 44%; border-top: 2px solid #4a3216;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 44%; border-top: 1px solid #c9a35d; margin-top: 2px;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 68%; border-top: 2px solid #4a3216;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 68%; border-top: 1px solid #c9a35d; margin-top: 2px;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 88%; border-top: 2px solid #4a3216;"></div>
          <div style="position: absolute; left: 16px; right: 16px; top: 88%; border-top: 1px solid #c9a35d; margin-top: 2px;"></div>
          <div style="position: absolute; left: 0; top: 15%; bottom: 0; width: 12px; background: linear-gradient(270deg,transparent,#4a3216); box-shadow: 1px 0 0 rgba(0,0,0,0.3);"></div>
          <div style="position: absolute; top: 56%; left: 50%; transform: translate(-50%,-50%); width: 16px; height: 11px; border-radius: 3px 3px 2px 2px; background: linear-gradient(180deg,#e8c98a,#8a6432); border: 1px solid #4a3216;"></div>
          <div style="position: absolute; top: 63%; left: 50%; transform: translate(-50%,0); width: 32px; height: 32px; border-radius: 50%; background: transparent; border: 6px solid #c9a35d; box-shadow: inset 0 2px 3px rgba(0,0,0,0.35), 0 1px 2px rgba(0,0,0,0.4);"></div>
        </div>
        <div onClick="{{ heroHintTap }}" style="position: absolute; bottom: 8%; left: 50%; transform: translateX(-50%); font-family: 'Parisienne', cursive; color: #F3E9CE; font-size: clamp(20px, 2.6vw, 30px); text-shadow: 0 2px 10px rgba(0,0,0,0.6); white-space: nowrap; cursor: pointer;">{{ heroHintText }}</div>
      </div>

      <div style="position: absolute; bottom: 0; left: 0; right: 0; z-index: 7; background: rgba(13,32,25,0.82); padding: 10px 16px; text-align: center; pointer-events: none;">
        <div style="font-family: 'Cormorant Garamond', serif; color: #E4C77A; font-size: clamp(12px, 1.6vw, 15px); letter-spacing: 0.1em; text-transform: uppercase; opacity: {{ doorOpenOpacity }}; transform: {{ line1Transform }}; transition: opacity 0.6s ease 0.15s, transform 0.6s ease 0.15s;">October 28 &ndash; 29, 2026 &middot; Colorado</div>
        <div style="font-family: 'Cormorant Garamond', serif; color: #A9BBA6; font-size: 11px; letter-spacing: 0.05em; margin-top: 2px; opacity: {{ doorOpenOpacity }}; transform: {{ line2Transform }}; transition: opacity 0.6s ease 0.4s, transform 0.6s ease 0.4s;">Daughter of Ravi Kumar &amp; Shanti Mandavilli &middot; Son of Badrinath &amp; Sarala Obbilisetty</div>
      </div>
    </div>
  </div>

  <!-- SLIDE 1: OUR STORY -->
  <div style="position: absolute; inset: 0; overflow-y: auto; display: flex; align-items: flex-start; justify-content: center; transition: transform 0.65s cubic-bezier(0.65,0,0.35,1), opacity 0.45s ease; transform: {{ s1.transform }}; opacity: {{ s1.opacity }}; z-index: {{ s1.z }}; pointer-events: {{ s1.pe }}; background: #FBF6E9;" onClick="{{ advance }}">
    <div style="padding: clamp(40px, 6vw, 72px) 24px; max-width: 780px; margin: 0 auto; text-align: center;">
      <div style="font-family: 'Parisienne', cursive; font-size: clamp(36px, 6vw, 56px); color: #1B3B2F; margin-bottom: 4px;">Our Story</div>
      <div class="gold-shimmer" style="width: 70px; height: 2px; background: #C6A144; margin: 18px auto 40px;"></div>
      <p style="font-family: 'Cormorant Garamond', serif; font-size: clamp(19px, 2.4vw, 23px); line-height: 1.75; color: #2F3D2B; margin: 0 0 26px; text-wrap: pretty;">Ours is a beautifully old-fashioned beginning. Our families connected us, and a few careful conversations quickly turned into something neither of us expected: the same values, the same way of thinking through life's big and small questions.</p>
      <p style="font-family: 'Cormorant Garamond', serif; font-size: clamp(19px, 2.4vw, 23px); line-height: 1.75; color: #2F3D2B; margin: 0 0 40px; text-wrap: pretty;">There was no dramatic meet-cute, just a quiet, growing certainty. So here we are: two people who believe we can complete each other, grow together, and figure the rest out one (probably chaotic, definitely fun) year at a time!</p>
      <div onClick="{{ stop }}" style="max-width: 460px; margin: 0 auto; aspect-ratio: 4/5; border: 1px solid #C6A144; border-radius: 8px; overflow: hidden;">
        <image-slot id="couple-photo" shape="rect" placeholder="Drop a couple photo"></image-slot>
      </div>
    </div>
  </div>

  <!-- SLIDE 2: SANGEETH EVENT -->
  <div style="position: absolute; inset: 0; overflow-y: auto; display: flex; align-items: flex-start; justify-content: center; transition: transform 0.65s cubic-bezier(0.65,0,0.35,1), opacity 0.45s ease; transform: {{ s2.transform }}; opacity: {{ s2.opacity }}; z-index: {{ s2.z }}; pointer-events: {{ s2.pe }}; background: #1B3B2F;" onClick="{{ advance }}">
    <div style="max-width: 900px; margin: 0 auto; padding: clamp(40px, 6vw, 72px) 24px;">
      <div style="text-align: center; margin-bottom: clamp(28px, 5vw, 40px);">
        <div style="font-family: 'Cormorant Garamond', serif; font-size: clamp(30px, 4.5vw, 44px); color: #F7EFDC; letter-spacing: 0.04em;">Wedding Events</div>
        <div class="gold-shimmer" style="width: 70px; height: 2px; background: #C6A144; margin: 18px auto 0;"></div>
      </div>
      <div style="position: relative; width: clamp(280px, 40vw, 360px); margin: 0 auto; background: #FBF6E9; border: 2px solid #C6A144; border-radius: 50% 50% 10px 10px / 26% 26% 10px 10px; padding: clamp(30px, 4vw, 40px) clamp(22px, 3vw, 28px) 32px; text-align: center;">
        <div style="position: absolute; inset: 10px; border: 1px dashed #C6A144; border-radius: 50% 50% 6px 6px / 25% 25% 6px 6px; pointer-events: none;"></div>
        <div onClick="{{ stop }}" style="width: 128px; height: 128px; margin: 0 auto 24px; border: 1px solid #C6A144; background: #fff;">
          <image-slot id="event-photo-sangeeth" shape="rect" placeholder="Event photo"></image-slot>
        </div>
        <div style="font-family: 'Cormorant Garamond', serif; font-size: clamp(24px, 3vw, 30px); font-weight: 600; letter-spacing: 0.06em; color: #1B3B2F; line-height: 1.15;">Sangeeth &amp; Dinner</div>
        <div style="width: 46px; height: 2px; background: #C6A144; margin: 16px auto;"></div>
        <div style="font-family: 'Cormorant Garamond', serif; font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase; color: #2F3D2B; font-weight: 600; margin-bottom: 6px;">Wednesday, October 28th 2026</div>
        <div style="font-size: 13.5px; color: #6B7A63; letter-spacing: 0.02em; margin-bottom: 18px;">Panakala Kaavidi at 3:00 PM &middot; Sangeeth &amp; Dinner at 5:00 PM</div>
        <div style="font-family: 'Cormorant Garamond', serif; font-size: 15px; letter-spacing: 0.06em; text-transform: uppercase; color: #2F3D2B; font-weight: 600; margin-bottom: 18px;">Philip S. Miller Park, Castle Rock, CO</div>
        <div style="font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 15.5px; color: #4A5A44; line-height: 1.6; margin-bottom: 16px;">&ldquo;Join us for an evening of music, dance, and celebration as we welcome the wedding festivities with joy.&rdquo;</div>
        <div onClick="{{ e3Toggle }}" style="display: inline-flex; align-items: center; gap: 6px; color: #B8862F; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; cursor: pointer; border-bottom: 1px solid #B8862F; padding-bottom: 2px;">
          More Details <span>{{ e3Chevron }}</span>
        </div>
        <sc-if value="{{ e3Expanded }}" hint-placeholder-val="{{ false }}">
          <div style="margin-top: 16px; font-size: 14px; color: #4A5A44; line-height: 1.6;">1381 W. Plum Creek Parkway, Castle Rock, CO 80109</div>
        </sc-if>
        <div onClick="{{ stop }}" style="margin-top: 22px;">
          <a href="https://maps.google.com/?q=1381%20W.%20Plum%20Creek%20Parkway%2C%20Castle%20Rock%2C%20CO%2080109" target="_blank" style="font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #8A9484;">Quick Map Link</a>
        </div>
      </div>
    </div>
  </div>

  <!-- SLIDE 3: WEDDING EVENT -->
  <div style="position: absolute; inset: 0; overflow-y: auto; display: flex; align-items: flex-start; justify-content: center; transition: transform 0.65s cubic-bezier(0.65,0,0.35,1), opacity 0.45s ease; transform: {{ s3.transform }}; opacity: {{ s3.opacity }}; z-index: {{ s3.z }}; pointer-events: {{ s3.pe }}; background: #1B3B2F;" onClick="{{ advance }}">
    <div style="max-width: 900px; margin: 0 auto; padding: clamp(40px, 6vw, 72px) 24px;">
      <div style="text-align: center; margin-bottom: clamp(28px, 5vw, 40px);">
        <div style="font-family: 'Cormorant Garamond', serif; font-size: clamp(30px, 4.5vw, 44px); color: #F7EFDC; letter-spacing: 0.04em;">Wedding Events</div>
        <div class="gold-shimmer" style="width: 70px; height: 2px; background: #C6A144; margin: 18px auto 0;"></div>
      </div>
      <div style="position: relative; width: clamp(280px, 40vw, 360px); margin: 0 auto; background: #FBF6E9; border: 2px solid #C6A144; border-radius: 50% 50% 10px 10px / 26% 26% 10px 10px; padding: clamp(30px, 4vw, 40px) clamp(22px, 3vw, 28px) 32px; text-align: center;">
        <div style="position: absolute; inset: 10px; border: 1px dashed #C6A144; border-radius: 50% 50% 6px 6px / 25% 25% 6px 6px; pointer-events: none;"></div>
        <div onClick="{{ stop }}" style="width: 128px; height: 128px; margin: 0 auto 24px; border: 1px solid #C6A144; background: #fff;">
          <image-slot id="event-photo-wedding" shape="rect" placeholder="Event photo"></image-slot>
        </div>
        <div style="font-family: 'Cormorant Garamond', serif; font-size: clamp(24px, 3vw, 30px); font-weight: 600; letter-spacing: 0.06em; color: #1B3B2F; line-height: 1.15;">Wedding Ceremony</div>
        <div style="width: 46px; height: 2px; background: #C6A144; margin: 16px auto;"></div>
        <div style="font-family: 'Cormorant Garamond', serif; font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase; color: #2F3D2B; font-weight: 600; margin-bottom: 6px;">Thursday, October 29th 2026</div>
        <div style="font-size: 13.5px; color: #6B7A63; letter-spacing: 0.02em; margin-bottom: 18px;">Ceremony 6:00 AM &middot; Muhurtham 8:50 AM &middot; Lunch Reception 11:30 AM&ndash;2:00 PM</div>
        <div style="font-family: 'Cormorant Garamond', serif; font-size: 15px; letter-spacing: 0.06em; text-transform: uppercase; color: #2F3D2B; font-weight: 600; margin-bottom: 18px;">Spruce Mountain Ranch, Larkspur, CO</div>
        <div style="font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 15.5px; color: #4A5A44; line-height: 1.6; margin-bottom: 16px;">&ldquo;Witness the sacred union of Vandana and Akhil in a traditional Telugu ceremony, followed by breakfast and a lunch reception.&rdquo;</div>
        <div onClick="{{ e4Toggle }}" style="display: inline-flex; align-items: center; gap: 6px; color: #B8862F; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; cursor: pointer; border-bottom: 1px solid #B8862F; padding-bottom: 2px;">
          More Details <span>{{ e4Chevron }}</span>
        </div>
        <sc-if value="{{ e4Expanded }}" hint-placeholder-val="{{ false }}">
          <div style="margin-top: 16px; font-size: 14px; color: #4A5A44; line-height: 1.6;">14771 S Spruce Mountain Rd, Larkspur, CO 80118</div>
        </sc-if>
        <div onClick="{{ stop }}" style="margin-top: 22px;">
          <a href="https://maps.google.com/?q=14771%20S%20Spruce%20Mountain%20Rd%2C%20Larkspur%2C%20CO%2080118" target="_blank" style="font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #8A9484;">Quick Map Link</a>
        </div>
      </div>
    </div>
  </div>

  <!-- SLIDE 4: RSVP -->
  <div style="position: absolute; inset: 0; overflow-y: auto; display: flex; align-items: flex-start; justify-content: center; transition: transform 0.65s cubic-bezier(0.65,0,0.35,1), opacity 0.45s ease; transform: {{ s4.transform }}; opacity: {{ s4.opacity }}; z-index: {{ s4.z }}; pointer-events: {{ s4.pe }}; background: #FBF6E9;" onClick="{{ advance }}">
    <div style="padding: clamp(40px, 6vw, 72px) 24px; max-width: 640px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 44px;">
        <div style="font-family: 'Cormorant Garamond', serif; font-size: clamp(30px, 4.5vw, 44px); color: #1B3B2F;">Kindly RSVP</div>
        <div class="gold-shimmer" style="width: 70px; height: 2px; background: #C6A144; margin: 18px auto 16px;"></div>
        <div style="font-family: 'Cormorant Garamond', serif; font-size: 19px; color: #4A5A44; font-style: italic; margin-bottom: 4px;">We can't wait to celebrate with you</div>
        <div style="font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #7A7052;">Kindly respond by September 29, 2026</div>
      </div>

      <sc-if value="{{ submitted }}" hint-placeholder-val="{{ false }}">
        <div style="text-align: center; background: #234936; border: 1px solid #C6A144; border-radius: 8px; padding: 48px 32px;">
          <div style="font-family: 'Parisienne', cursive; font-size: 32px; color: #E4C77A; margin-bottom: 10px;">Thank you!</div>
          <div style="color: #F7EFDC; font-size: 16px; line-height: 1.6;">Your RSVP email is ready &mdash; please hit send in your mail app to confirm. We can't wait to see you!</div>
        </div>
      </sc-if>

      <sc-if value="{{ notSubmitted }}" hint-placeholder-val="{{ true }}">
        <div onClick="{{ stop }}" style="position: relative; background: #FFFDF6; border: 1px solid #C6A144; border-radius: 8px; padding: clamp(28px, 4vw, 44px);">
          <div style="position: absolute; top: -10px; left: -10px; width: 20px; height: 20px; border-top: 2px solid #C6A144; border-left: 2px solid #C6A144; border-radius: 6px 0 0 0;"></div>
          <div style="position: absolute; top: -10px; right: -10px; width: 20px; height: 20px; border-top: 2px solid #C6A144; border-right: 2px solid #C6A144; border-radius: 0 6px 0 0;"></div>
          <div style="position: absolute; bottom: -10px; left: -10px; width: 20px; height: 20px; border-bottom: 2px solid #C6A144; border-left: 2px solid #C6A144; border-radius: 0 0 0 6px;"></div>
          <div style="position: absolute; bottom: -10px; right: -10px; width: 20px; height: 20px; border-bottom: 2px solid #C6A144; border-right: 2px solid #C6A144; border-radius: 0 0 6px 0;"></div>
          <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #4A5A44; margin-bottom: 6px;">Full Name</label>
            <input type="text" value="{{ form.name }}" onChange="{{ onName }}" placeholder="Your name" style="width: 100%; padding: 12px 14px; border: 1px solid #C9BE9A; border-radius: 4px; font-family: 'Poppins', sans-serif; font-size: 15px; background: #fff;" />
          </div>
          <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #4A5A44; margin-bottom: 6px;">Email</label>
            <input type="email" value="{{ form.email }}" onChange="{{ onEmail }}" placeholder="you@example.com" style="width: 100%; padding: 12px 14px; border: 1px solid #C9BE9A; border-radius: 4px; font-family: 'Poppins', sans-serif; font-size: 15px; background: #fff;" />
          </div>
          <div style="display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap;">
            <div style="flex: 1 1 160px;">
              <label style="display: block; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #4A5A44; margin-bottom: 6px;">Attending?</label>
              <select value="{{ form.attending }}" onChange="{{ onAttending }}" style="width: 100%; padding: 12px 14px; border: 1px solid #C9BE9A; border-radius: 4px; font-family: 'Poppins', sans-serif; font-size: 15px; background: #fff;">
                <option value="yes">Joyfully accept</option>
                <option value="no">Regretfully decline</option>
              </select>
            </div>
            <div style="flex: 1 1 120px;">
              <label style="display: block; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #4A5A44; margin-bottom: 6px;">Guests</label>
              <input type="number" min="1" value="{{ form.guests }}" onChange="{{ onGuests }}" style="width: 100%; padding: 12px 14px; border: 1px solid #C9BE9A; border-radius: 4px; font-family: 'Poppins', sans-serif; font-size: 15px; background: #fff;" />
            </div>
          </div>

          <div style="margin-bottom: 24px;">
            <label style="display: block; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #4A5A44; margin-bottom: 10px;">Which events will you join?</label>
            <sc-for list="{{ eventChoices }}" as="ec" hint-placeholder-count="2">
              <label style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-size: 15px; color: #26301F; cursor: pointer;">
                <input type="checkbox" checked="{{ ec.checked }}" onChange="{{ ec.toggle }}" style="width: 17px; height: 17px; accent-color: #1B3B2F;" />
                {{ ec.label }}
              </label>
            </sc-for>
          </div>

          <div style="margin-bottom: 28px;">
            <label style="display: block; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: #4A5A44; margin-bottom: 6px;">Message (optional)</label>
            <textarea value="{{ form.message }}" onChange="{{ onMessage }}" placeholder="A note for the couple" rows="3" style="width: 100%; padding: 12px 14px; border: 1px solid #C9BE9A; border-radius: 4px; font-family: 'Poppins', sans-serif; font-size: 15px; background: #fff; resize: vertical;"></textarea>
          </div>

          <button onClick="{{ onSubmit }}" style="width: 100%; padding: 16px; background: #1B3B2F; color: #F7EFDC; border: none; border-radius: 4px; font-family: 'Cormorant Garamond', serif; font-size: 20px; letter-spacing: 0.06em; cursor: pointer;" style-hover="background: #234936;">Send RSVP</button>
          <div style="text-align: center; margin-top: 14px; font-size: 13px; color: #7A7052;">This sends your response by email to vandu.mandavilli9@gmail.com</div>
        </div>
      </sc-if>
    </div>
  </div>

  <!-- SLIDE 5: GUEST ASSISTANT + FOOTER -->
  <div style="position: absolute; inset: 0; overflow-y: auto; display: flex; flex-direction: column; transition: transform 0.65s cubic-bezier(0.65,0,0.35,1), opacity 0.45s ease; transform: {{ s5.transform }}; opacity: {{ s5.opacity }}; z-index: {{ s5.z }}; pointer-events: {{ s5.pe }}; background: #16414C;" onClick="{{ advance }}">
    <div style="flex: 1; display: flex; align-items: flex-start; justify-content: center; padding: clamp(40px, 8vw, 72px) 24px; overflow-y: auto;">
      <div style="text-align: center;">
        <div style="font-family: 'Cormorant Garamond', serif; font-size: clamp(26px, 3.6vw, 34px); color: #F7EFDC; margin-bottom: 12px;">Planning your trip? Have a question?</div>
        <div style="color: #BFDCE0; font-size: 16px; max-width: 520px; margin: 0 auto 28px; line-height: 1.6;">Our Wedding Guest Assistant can help with events, directions, timing and more &mdash; any time, day or night.</div>
        <span onClick="{{ stop }}">
          <a href="https://web-production-0eeea.up.railway.app" target="_blank" style="display: inline-block; padding: 15px 36px; background: #C6A144; color: #1B3B2F; border-radius: 4px; font-family: 'Cormorant Garamond', serif; font-size: 19px; font-weight: 600; letter-spacing: 0.04em;">Chat with the Guest Assistant</a>
        </span>
      </div>
    </div>
    <div style="background: #1B3B2F; padding: 32px 24px; text-align: center; border-top: 2px solid #C6A144;">
      <div style="font-family: 'Parisienne', cursive; font-size: 26px; color: #E4C77A; margin-bottom: 6px;">Vandana &amp; Akhil</div>
      <div style="color: #A9BBA6; font-size: 13px; letter-spacing: 0.06em;">October 28&ndash;29, 2026 &middot; Colorado, USA</div>
    </div>
  </div>

  <!-- PROGRESS DOTS -->
  <div style="position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); z-index: 50; display: flex; gap: 9px; pointer-events: auto;">
    <sc-for list="{{ dots }}" as="dot" hint-placeholder-count="7">
      <div onClick="{{ dot.onClick }}" style="width: {{ dot.size }}; height: {{ dot.size }}; border-radius: 50%; background: {{ dot.color }}; cursor: pointer; box-shadow: 0 0 0 1px rgba(0,0,0,0.15);"></div>
    </sc-for>
  </div>

  <!-- BACK BUTTON -->
  <sc-if value="{{ showBack }}" hint-placeholder-val="{{ false }}">
    <div onClick="{{ backTap }}" style="position: absolute; top: 18px; left: 18px; z-index: 50; width: 38px; height: 38px; border-radius: 50%; background: rgba(13,32,25,0.55); color: #F3E9CE; display: flex; align-items: center; justify-content: center; font-size: 18px; cursor: pointer;">&#8249;</div>
  </sc-if>

</div>

</x-dc>
<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  totalSlides = 6;

  state = {
    submitted: false,
    form: { name: '', email: '', attending: 'yes', guests: 1, message: '' },
    eventFlags: { e3: true, e4: true },
    expanded: { e3: false, e4: false },
    doorOpen: false,
    musicOn: false,
    slideIndex: 0
  };

  audioRef = React.createRef();

  toggleDoor = () => this.setState(s => {
    if (!s.doorOpen && this.audioRef.current) {
      this.audioRef.current.volume = 0.6;
      this.audioRef.current.play().catch(() => {});
    }
    return { doorOpen: !s.doorOpen };
  });

  toggleMusic = () => {
    const el = this.audioRef.current;
    if (!el) return;
    if (el.paused) { el.play().catch(() => {}); this.setState({ musicOn: true }); }
    else { el.pause(); this.setState({ musicOn: false }); }
  };

  advance = () => this.setState(s => ({ slideIndex: Math.min(s.slideIndex + 1, this.totalSlides - 1) }));
  goBack = () => this.setState(s => ({ slideIndex: Math.max(s.slideIndex - 1, 0) }));
  goTo = i => this.setState({ slideIndex: i });

  stop = e => { e.stopPropagation(); };

  heroHintTap = e => {
    e.stopPropagation();
    if (this.state.doorOpen) this.advance(); else this.toggleDoor();
  };

  backTap = e => { e.stopPropagation(); this.goBack(); };

  labels = { e3: 'Sangeeth & Dinner Reception', e4: 'Wedding Ceremony & Reception' };

  updateForm(key, value) {
    this.setState(s => ({ form: { ...s.form, [key]: value } }));
  }

  toggleEvent(id) {
    this.setState(s => ({ eventFlags: { ...s.eventFlags, [id]: !s.eventFlags[id] } }));
  }

  toggleExpanded(id) {
    this.setState(s => ({ expanded: { ...s.expanded, [id]: !s.expanded[id] } }));
  }

  handleSubmit() {
    const f = this.state.form;
    const chosenTitles = { e3: 'Sangeeth & Dinner', e4: 'Wedding Ceremony' };
    const chosen = Object.keys(this.state.eventFlags).filter(id => this.state.eventFlags[id]).map(id => chosenTitles[id]).join(', ') || 'None selected';
    const subject = encodeURIComponent(`RSVP from ${f.name || 'Guest'}`);
    const body = encodeURIComponent(
      `Name: ${f.name}\nEmail: ${f.email}\nAttending: ${f.attending === 'yes' ? 'Joyfully accepts' : 'Regretfully declines'}\nGuests: ${f.guests}\nEvents: ${chosen}\nMessage: ${f.message}`
    );
    window.open(`mailto:vandu.mandavilli9@gmail.com?subject=${subject}&body=${body}`, '_blank');
    try {
      const saved = JSON.parse(localStorage.getItem('wedding-rsvps') || '[]');
      saved.push({ ...f, events: chosen, submittedAt: new Date().toISOString() });
      localStorage.setItem('wedding-rsvps', JSON.stringify(saved));
    } catch (e) {}
    this.setState({ submitted: true });
  }

  slideStyle(i) {
    const diff = i - this.state.slideIndex;
    if (diff === 0) return { transform: 'translateY(0)', opacity: 1, z: 3, pe: 'auto' };
    if (diff < 0) return { transform: 'translateY(-100%)', opacity: 0, z: 1, pe: 'none' };
    return { transform: 'translateY(100%)', opacity: 1, z: 2, pe: 'none' };
  }

  renderVals() {
    const doorOpen = this.state.doorOpen;
    const doorLeftTransform = doorOpen ? 'rotateY(-108deg)' : 'rotateY(0deg)';
    const doorRightTransform = doorOpen ? 'rotateY(108deg)' : 'rotateY(0deg)';
    const doorPointerEvents = doorOpen ? 'none' : 'auto';
    const heroHintText = doorOpen ? 'Continue \u2193' : 'Tap to open';
    const doorOpenOpacity = doorOpen ? 1 : 0;
    const line1Transform = doorOpen ? 'translateY(0)' : 'translateY(10px)';
    const line2Transform = doorOpen ? 'translateY(0)' : 'translateY(10px)';
    const heroLineTransform = doorOpen ? 'translateY(0)' : 'translateY(14px)';

    const eventChoices = Object.keys(this.labels).map(id => ({
      label: this.labels[id],
      checked: this.state.eventFlags[id],
      toggle: () => this.toggleEvent(id)
    }));

    const idx = this.state.slideIndex;
    const dots = Array.from({ length: this.totalSlides }, (_, i) => ({
      onClick: e => { e.stopPropagation(); this.goTo(i); },
      size: i === idx ? '10px' : '7px',
      color: i === idx ? '#C6A144' : 'rgba(200,200,200,0.6)'
    }));

    return {
      doorOpen, doorLeftTransform, doorRightTransform, doorPointerEvents, heroHintText, doorOpenOpacity, line1Transform, line2Transform, heroLineTransform,
      musicOn: this.state.musicOn, musicOff: !this.state.musicOn, audioRef: this.audioRef, toggleMusic: this.toggleMusic,
      toggleDoor: this.toggleDoor, heroHintTap: this.heroHintTap,
      advance: this.advance, stop: this.stop, backTap: this.backTap,
      showBack: idx > 0,
      dots,
      s0: this.slideStyle(0), s1: this.slideStyle(1), s2: this.slideStyle(2), s3: this.slideStyle(3), s4: this.slideStyle(4), s5: this.slideStyle(5),
      e3Expanded: this.state.expanded.e3, e3Chevron: this.state.expanded.e3 ? '\u25b4' : '\u25be', e3Toggle: e => { e.stopPropagation(); this.toggleExpanded('e3'); },
      e4Expanded: this.state.expanded.e4, e4Chevron: this.state.expanded.e4 ? '\u25b4' : '\u25be', e4Toggle: e => { e.stopPropagation(); this.toggleExpanded('e4'); },
      eventChoices,
      form: this.state.form,
      submitted: this.state.submitted,
      notSubmitted: !this.state.submitted,
      onName: e => this.updateForm('name', e.target.value),
      onEmail: e => this.updateForm('email', e.target.value),
      onAttending: e => this.updateForm('attending', e.target.value),
      onGuests: e => this.updateForm('guests', e.target.value),
      onMessage: e => this.updateForm('message', e.target.value),
      onSubmit: () => this.handleSubmit()
    };
  }
}

</script>
</body>
</html>
